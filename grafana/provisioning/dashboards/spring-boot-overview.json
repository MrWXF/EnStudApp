{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "JVM 内存使用",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by(service)(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{service}} - Heap Used"
        },
        {
          "expr": "sum by(service)(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "{{service}} - Heap Max"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      }
    },
    {
      "title": "HTTP 请求速率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by(service)(rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps" }
      }
    },
    {
      "title": "HTTP 请求延迟 (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(service, le)(rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{service}} - P95"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "HTTP 错误率",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by(service)(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by(service)(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit" }
      }
    },
    {
      "title": "数据库连接池",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by(service)(hikaricp_connections_active)",
          "legendFormat": "{{service}} - Active"
        },
        {
          "expr": "sum by(service)(hikaricp_connections_idle)",
          "legendFormat": "{{service}} - Idle"
        }
      ]
    },
    {
      "title": "线程池",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum by(service)(jvm_threads_live_threads)",
          "legendFormat": "{{service}} - Live"
        },
        {
          "expr": "sum by(service)(jvm_threads_daemon_threads)",
          "legendFormat": "{{service}} - Daemon"
        }
      ]
    },
    {
      "title": "GC 暂停时间",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "sum by(service)(rate(jvm_gc_pause_seconds_sum[5m]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      }
    },
    {
      "title": "系统健康状态",
      "type": "stat",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "up",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["enstudapp", "spring-boot"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "EnStudApp - Spring Boot Overview",
  "uid": "enstudapp-spring-boot",
  "version": 1
