# 开发环境变量模板
# 复制此文件为 .env 后填入实际值

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=13306

# Redis
REDIS_PORT=6379

# Nacos
NACOS_PORT=8848
NACOS_GRPC_PORT=9848

# Gateway
GATEWAY_PORT=8080

# 微服务端口
USER_SERVICE_PORT=8081
WORD_SERVICE_PORT=8082
CHAT_SERVICE_PORT=8083
WRITING_SERVICE_PORT=8084
TRANSLATE_SERVICE_PORT=8085
FORUM_SERVICE_PORT=8086
READ_SERVICE_PORT=8087

# Nginx
NGINX_PORT=80

# 可观测性
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# JWT 密钥（生产环境必须更换）
JWT_SECRET=enstud-app-jwt-secret-key-2024-production-must-change

# AI 服务（根据实际使用的 AI 提供商配置）
# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# AI 每日配额（每用户）
DEEPSEEK_CHAT_DAILY_LIMIT=50
DEEPSEEK_WRITING_DAILY_LIMIT=10
DEEPSEEK_TRANSLATE_DAILY_LIMIT=100

# 翻译服务
DEEPL_API_KEY=

# 语音服务
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# OSS 文件存储
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_BUCKET=
OSS_ENDPOINT=
